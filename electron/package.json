{
  "name": "electron",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "npm run build:electron && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build && npm run build:electron",
    "test": "vitest run",
    "lint": "oxlint src electron scripts",
    "preview": "vite preview",
    "build:electron": "tsc --project tsconfig.electron.json && node scripts/finalize-electron.mjs",
    "start": "cross-env COMPRAS_RENDERER_FILE=1 electron .",
    "smoke": "electron scripts/smoke.cjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.10.0",
    "electron-builder": "^26.15.3",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.1.0"
  }
}
